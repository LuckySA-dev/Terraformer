# Copy this file to .env. It intentionally contains no passwords, API keys,
# device credentials, or encryption keys. Generate local file secrets with:
#   python deploy/init-secrets.py

COMPOSE_PROJECT_NAME=terraformer
APP_IMAGE_TAG=local

# The production-like stack publishes only the web reverse proxy. Keep this on
# loopback unless you have reviewed docs/safety-model.md and secured the host.
HOST_BIND=127.0.0.1
WEB_PORT=8080

# These ports are published on loopback only by deploy/compose.dev.yml.
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

APP_ENV=production
LOG_LEVEL=INFO
MAX_DEVICE_CONNECTIONS=10
SSH_CONNECT_TIMEOUT_SECONDS=10
SSH_COMMAND_TIMEOUT_SECONDS=30
SSH_LEGACY_ENABLED=false
SSH_GROUP1_ENABLED=false
SSH_VERY_OLD_ENABLED=false
SSH_TERMINAL_ENABLED=true
# Read-only configuration analysis via Batfish. Requires the analysis Compose
# profile (deploy/compose.analysis.yml) and the optional `analysis` dependency
# group. Off by default: it adds a container that needs several GB of RAM
# while parsing.
ANALYSIS_ENABLED=false
# Telnet consoles for GNS3/EVE-NG lab nodes. Cleartext, with no host identity
# to verify: enable only for an isolated virtual lab, never for real hardware.
# Devices must also be marked as lab devices before telnet can be selected.
TELNET_ENABLED=false
TERMINAL_PTY_TIMEOUT_SECONDS=10
TERMINAL_MAX_DURATION_SECONDS=3600
CONNECTION_TEST_RATE_LIMIT=5
TERMINAL_OPEN_RATE_LIMIT=5
CONNECTION_RATE_WINDOW_SECONDS=60
AUTHENTICATION_FAILURE_LIMIT=3
AUTHENTICATION_FAILURE_WINDOW_SECONDS=60
AUTHENTICATION_COOLDOWN_SECONDS=60
MAX_CONNECTIONS_PER_DEVICE=3
MAX_TERMINAL_SESSIONS=3
MAX_TERMINAL_SESSIONS_PER_DEVICE=3
CONNECTION_PERMIT_TTL_SECONDS=3900

# SSH host-key verification is mandatory and uses the per-device pin confirmed
# in the application. There is no global relaxed host-key setting.

# Local HTTP cannot set a Secure cookie. Set this to true only when TLS is
# terminated in front of the web service.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080

# Paths are resolved relative to deploy/compose.yml. The defaults below point
# at ignored files generated under the repository-level .secrets directory.
MASTER_KEY_FILE_HOST=../.secrets/master.key
POSTGRES_PASSWORD_FILE_HOST=../.secrets/postgres.password
